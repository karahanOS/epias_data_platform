## 📁 Proje Yapısı

epias_data_platform/
├── dags/
│   ├── epias_dag.py                  # Ana Airflow DAG (günlük ingestion)
│   ├── epias_backfill_dag.py         # Geçmiş veri backfill DAG'ı
│   ├── epias_sources.py              # Kaynak/tablo tanımları
│   └── ptf_inference_dag.py          # PTF tahmin DAG'ı
├── src/
│   ├── epias_client.py               # EPIAŞ API Wrapper
│   ├── weather_client.py             # Meteoroloji API Wrapper
│   ├── fx_client.py                  # Döviz kuru API Wrapper
│   ├── load_to_bigquery.py           # BigQuery yükleme yardımcıları
│   ├── data_quality_check.py         # Veri kalitesi kontrolleri
│   ├── ptf_features.py               # ML feature engineering
│   ├── ptf_trainer.py                # XGBoost model eğitimi
│   ├── ptf_inference.py              # Tahmin çalıştırma
│   ├── model_comparison.py           # Model performans karşılaştırma
│   └── config.py                     # Ortak konfigürasyon
├── spark_jobs/
│   ├── bronze_to_silver_*.py         # 25+ Spark ETL süreci (PTF, SMF, DPP,
│   │                                  #  SBFGP, hava durumu, FX, tüketim, vb.)
│   ├── spark_utils.py                # Ortak Spark yardımcıları
│   └── gcs-connector-hadoop3-*.jar   # GCS bağlantı köprüsü
├── credentials/
│   └── gcp-key.json                  # Google Cloud anahtarı
├── epias_dbt/
│   └── models/                       # BigQuery dbt modelleri (staging + marts)
├── tests/                            # Birim/entegrasyon testleri
├── scripts/                          # Yardımcı script'ler
├── docs/                             # Ek dokümantasyon
├── dashboard.py                      # Streamlit yönetici özeti (çok sayfalı)
├── Dockerfile                        # Özelleştirilmiş Airflow imajı
└── docker-compose.yml                # Servis orkestrasyonu

